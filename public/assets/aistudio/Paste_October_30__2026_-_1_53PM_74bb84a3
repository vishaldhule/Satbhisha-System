A. Multiple voice problem — single audio manager
Developer ko ye logic implement karna chahiye:
let currentAudio = null;
let isSpeaking = false;

async function speak(text) {
  if (isSpeaking) {
    return;
  }

  isSpeaking = true;

  try {
    const response = await fetch("/api/voice/speak", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ text })
    });

    if (!response.ok) {
      throw new Error("Voice generation failed");
    }

    const blob = await response.blob();

    currentAudio = new Audio(
      URL.createObjectURL(blob)
    );

    await currentAudio.play();

    await new Promise((resolve, reject) => {
      currentAudio.onended = resolve;
      currentAudio.onerror = reject;
    });

  } finally {
    currentAudio = null;
    isSpeaking = false;
  }
}

function stopSpeaking() {
  if (currentAudio) {
    currentAudio.pause();
    currentAudio.currentTime = 0;
    currentAudio = null;
  }

  isSpeaking = false;
}


Ye basic single-playback example hai. Production version mein request IDs, cancellation, race-condition protection aur object URL cleanup bhi implement karna hoga.
